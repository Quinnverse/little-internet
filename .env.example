# Little Internet — publish service configuration
# Copy to .env and fill in. NEVER commit the real .env.

# --- Required ---------------------------------------------------------------
# Long random secret used to salt site-owner token hashes. Generate with:
#   openssl rand -hex 32
# Keep this out of git. Rotating it invalidates all stored owner credentials.
SITE_TOKEN_SALT=REPLACE_WITH_openssl_rand_hex_32

# Public origin where published sites live (no trailing slash).
PUBLIC_BASE_URL=https://little.quinnverse.tech

# --- Storage & network ------------------------------------------------------
# Directory (inside the container) where sites, meta and backups live.
# In Compose this maps to ./data on the host; keep it on a persistent volume.
DATA_DIR=/data

# Port the Node publish service listens on INSIDE its container.
PORT=8788
HOST=127.0.0.1

# Publish requests allowed per client IP per 60s window (all write endpoints).
RATE_LIMIT=30

# Set to 1 ONLY if the service is exclusively behind a trusted reverse proxy
# that overwrites X-Forwarded-For. Otherwise a client can spoof the rate key.
TRUST_PROXY=0

# --- Caddy (reverse proxy / HTTPS) -----------------------------------------
# Host port that Caddy exposes. The default 8080/8443 do NOT take over the
# server's existing 80/443. Point your existing edge proxy (or a DNS + port
# forward) at these, or switch to the standalone profile to bind 80/443.
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
